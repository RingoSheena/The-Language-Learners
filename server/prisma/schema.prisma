// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  // Flashcard target recall, see shared/srs.js
  desiredRetention Float @default(0.9)

  books        Book[]
  flashcards   Flashcard[]
  reviewLogs   ReviewLog[]
}

model Flashcard {
  id         String   @id @default(uuid())
  japanese   String
  reading    String   @default("")
  definition String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Spaced repetition schedule (FSRS), see shared/srs.js. Stability and
  // difficulty are null until the card's first review.
  dueAt          DateTime  @default(now())
  intervalDays   Float     @default(0)
  stability      Float?
  difficulty     Float?
  lapses         Int       @default(0)
  lastReviewedAt DateTime?

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]

  @@unique([userId, japanese])
}

// One row per graded flashcard, for practice stats. Kept when the card is
// deleted, so past days' totals don't change.
model ReviewLog {
  id              String   @id @default(uuid())
  grade           String   // fail | hard | medium | easy
  reviewedAt      DateTime @default(now())
  // Time from the card being shown to it being graded, capped server-side
  durationMs      Int
  intervalDays    Float    // before this review
  newIntervalDays Float    // after it

  cardId     String?
  card       Flashcard? @relation(fields: [cardId], references: [id], onDelete: SetNull)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, reviewedAt])
  @@index([cardId])
}

model Book {
  id        String   @id @default(uuid())
  title     String
  fileName  String
  data      Bytes
  // Data URL of the first image in the EPUB, extracted by the client
  coverImage   String?
  createdAt    DateTime  @default(now())
  lastOpenedAt DateTime?
  // Where the reader left off, as captured by client/src/readingState.js
  readingPosition Json?

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([userId])
}

model Bookmark {
  id        String   @id @default(uuid())
  label     String
  // Same shape as Book.readingPosition
  position  Json
  createdAt DateTime @default(now())

  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
}
