DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yomu?schema=public"
PORT=3001

# Signs/verifies login session cookies -- required, the server refuses to
# start without it. Generate a real one with: openssl rand -hex 32
JWT_SECRET="replace-with-a-long-random-value"

# Origin the browser's requests to the API are allowed to come from, needed
# for cookies to work cross-origin (CORS can't use "*" with credentials).
CLIENT_ORIGIN="http://localhost:5173"
